{
  "name": "handover-pro",
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:legacy": "jest --config jest.config.cjs --passWithNoTests",
    "test": "vitest run --config vitest.pilot.config.ts",
    "test:watch": "vitest --config vitest.pilot.config.ts",
    "test:legacy:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "vitest run --config vitest.pilot.config.ts --coverage",
    "test:legacy:cov": "jest --config jest.config.cjs --coverage",
    "test:unit": "vitest run",
    "test:unit:cov": "vitest run --coverage",
    "test:pilot": "vitest run --config vitest.pilot.config.ts",
    "test:pilot:coverage": "vitest run --config vitest.pilot.config.ts --coverage",
    "test:pilot:coverage:ci": "vitest run --config vitest.pilot.config.ts --reporter=verbose --coverage --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=cobertura --coverage.reportsDirectory=coverage",
    "test:smoke:forms": "vitest run src/screens/__tests__/handover.sections.spec.tsx src/screens/__tests__/handover.visibility.spec.ts src/screens/handover/__tests__/submission.spec.ts tests/screens/HandoverForm.draft.spec.tsx tests/screens/HandoverForm.network-errors.spec.tsx tests/screens/HandoverForm.patientHeader.spec.tsx tests/screens/HandoverForm.sbar.spec.tsx",
    "precommit": "pnpm typecheck && pnpm lint && pnpm test",
    "validate:fhir": "tsx scripts/validate-fhir.ts",
    "validate:fhir:fixture": "tsx scripts/validate-fhir.ts tests/fixtures/fhir/minimal-transaction-bundle.json",
    "gate:any-sensitive": "tsx scripts/check-sensitive-anys.ts",
    "gate:any-sensitive:write": "tsx scripts/check-sensitive-anys.ts --write-baseline",
    "quality:pilot": "pnpm typecheck && pnpm lint:ci && pnpm gate:any-sensitive && pnpm test:pilot:coverage && pnpm validate:fhir",
    "quality:pilot:ci": "pnpm -w typecheck && pnpm -w lint:ci && pnpm -w gate:any-sensitive && pnpm -w test:pilot:coverage:ci && pnpm -w test:e2e && pnpm -w validate:fhir",
    "test:e2e": "playwright test",
    "lint:ci": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@noble/ciphers": "^2.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "buffer": "^5.7.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "expo": "55.0.15",
    "expo-asset": "~55.0.15",
    "expo-audio": "~55.0.13",
    "expo-auth-session": "~55.0.14",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~55.0.13",
    "expo-camera": "~55.0.15",
    "expo-constants": "~55.0.14",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.27",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.16",
    "expo-image-picker": "~55.0.18",
    "expo-linking": "~55.0.13",
    "expo-network": "~55.0.13",
    "expo-notifications": "~55.0.19",
    "expo-print": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-speech": "~55.0.13",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "express": "^5.1.0",
    "js-sha256": "^0.11.0",
    "multer": "^2.0.2",
    "nativewind": "4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "react-native": "0.85.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.1",
    "uuid": "^13.0.0",
    "victory-native": "^36.8.0",
    "zod": "^3.23.8",
    "expo-random": "~14.0.1",
    "react-native-get-random-values": "~2.0.0"
  },
  "devDependencies": {
    "@expo/cli": "^54.0.13",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "29.5.14",
    "@types/node": "^20.14.10",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "2.1.9",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.10",
    "eslint": "^9.39.1",
    "jest": "29.7.0",
    "jest-expo": "54.0.16",
    "jsdom": "^27.0.0",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "3.4.13",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {}
  },
  "private": true
}

