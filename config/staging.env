# Staging environment (QA)
EXPO_PUBLIC_API_BASE_URL=https://staging-api.example.com
EXPO_PUBLIC_FHIR_BASE_URL=https://staging-fhir.example.com
EXPO_PUBLIC_ALLOWED_UNITS=UCI,URG
EXPO_PUBLIC_ALLOW_ALL_UNITS=false
EXPO_PUBLIC_BYPASS_SCOPE=false
EXPO_PUBLIC_STORAGE_NAMESPACE=handover-staging
EXPO_PUBLIC_OFFLINE_ENCRYPTION_KEY=replace-with-32-char-secret
EXPO_PUBLIC_OFFLINE_REPLAY_MAX_ATTEMPTS=8
EXPO_PUBLIC_QUEUE_BACKOFF_BASE=2
EXPO_PUBLIC_FAST_VALIDATE_BEFORE_QUEUE=true
EXPO_PUBLIC_CLIENT_SIGNING_ENABLED=false
EXPO_PUBLIC_HANDOVER_FHIR_VALIDATION_MODE=remote
EXPO_PUBLIC_OFFLINE_ENCRYPTION_DISABLED=false

OIDC_ISSUER=https://staging-auth.example.com/
OIDC_CLIENT_ID=replace-with-client-id
OIDC_AUDIENCE=https://staging-api.example.com
OIDC_SCOPE=openid profile email
OIDC_REDIRECT_SCHEME=handover-staging
