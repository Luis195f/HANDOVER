FROM node:20-slim AS builder

WORKDIR /app

ENV EXPO_NO_TELEMETRY=1

RUN corepack enable
RUN corepack prepare pnpm@10 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm -w install --frozen-lockfile

COPY . .

ARG EXPO_PUBLIC_API_BASE_URL
ARG EXPO_PUBLIC_FHIR_BASE_URL
ARG EXPO_PUBLIC_ALLOWED_UNITS
ARG EXPO_PUBLIC_STORAGE_NAMESPACE
ARG EXPO_PUBLIC_OFFLINE_REPLAY_MAX_ATTEMPTS
ARG EXPO_PUBLIC_QUEUE_BACKOFF_BASE
ARG EXPO_PUBLIC_FAST_VALIDATE_BEFORE_QUEUE
ARG EXPO_PUBLIC_HANDOVER_FHIR_VALIDATION_MODE
ARG EXPO_PUBLIC_HANDOVER_DEPLOYMENT_MODE
ARG EXPO_PUBLIC_HANDOVER_PILOT_CONTROL_JSON
ARG EXPO_PUBLIC_HANDOVER_UNITS_JSON
ARG EXPO_PUBLIC_HANDOVER_PROFILE_ACTIVATION_JSON
ARG EXPO_PUBLIC_SHOW_NIC_CODING
ARG EXPO_PUBLIC_SHOW_NOC_OUTCOMES
ARG EXPO_PUBLIC_SHOW_HANDOVER_TIMING_METRICS
ARG EXPO_PUBLIC_HIDE_LEGACY_FIELDS
ARG EXPO_PUBLIC_ENABLE_ICEA_BRIDGE
ARG EXPO_PUBLIC_ENABLE_ICEA_IMMEDIATE_SCORING
ARG EXPO_PUBLIC_ENABLE_ICEA_ENRICHED_SCORING
ARG EXPO_PUBLIC_ENABLE_ICEA_PATIENT_RISK
ARG EXPO_PUBLIC_ENABLE_ICEA_CAUSAL_SUMMARY
ARG EXPO_PUBLIC_AI_SUGGESTIONS_ENABLED
ARG EXPO_PUBLIC_ENABLE_DEMO
ARG OIDC_ISSUER
ARG OIDC_CLIENT_ID
ARG OIDC_AUDIENCE
ARG OIDC_SCOPE
ARG OIDC_REDIRECT_SCHEME

ENV NODE_ENV=production
ENV EXPO_PUBLIC_API_BASE_URL=$EXPO_PUBLIC_API_BASE_URL
ENV EXPO_PUBLIC_FHIR_BASE_URL=$EXPO_PUBLIC_FHIR_BASE_URL
ENV EXPO_PUBLIC_ALLOWED_UNITS=$EXPO_PUBLIC_ALLOWED_UNITS
ENV EXPO_PUBLIC_STORAGE_NAMESPACE=$EXPO_PUBLIC_STORAGE_NAMESPACE
ENV EXPO_PUBLIC_OFFLINE_REPLAY_MAX_ATTEMPTS=$EXPO_PUBLIC_OFFLINE_REPLAY_MAX_ATTEMPTS
ENV EXPO_PUBLIC_QUEUE_BACKOFF_BASE=$EXPO_PUBLIC_QUEUE_BACKOFF_BASE
ENV EXPO_PUBLIC_FAST_VALIDATE_BEFORE_QUEUE=$EXPO_PUBLIC_FAST_VALIDATE_BEFORE_QUEUE
ENV EXPO_PUBLIC_HANDOVER_FHIR_VALIDATION_MODE=$EXPO_PUBLIC_HANDOVER_FHIR_VALIDATION_MODE
ENV EXPO_PUBLIC_HANDOVER_DEPLOYMENT_MODE=$EXPO_PUBLIC_HANDOVER_DEPLOYMENT_MODE
ENV EXPO_PUBLIC_HANDOVER_PILOT_CONTROL_JSON=$EXPO_PUBLIC_HANDOVER_PILOT_CONTROL_JSON
ENV EXPO_PUBLIC_HANDOVER_UNITS_JSON=$EXPO_PUBLIC_HANDOVER_UNITS_JSON
ENV EXPO_PUBLIC_HANDOVER_PROFILE_ACTIVATION_JSON=$EXPO_PUBLIC_HANDOVER_PROFILE_ACTIVATION_JSON
ENV EXPO_PUBLIC_SHOW_NIC_CODING=$EXPO_PUBLIC_SHOW_NIC_CODING
ENV EXPO_PUBLIC_SHOW_NOC_OUTCOMES=$EXPO_PUBLIC_SHOW_NOC_OUTCOMES
ENV EXPO_PUBLIC_SHOW_HANDOVER_TIMING_METRICS=$EXPO_PUBLIC_SHOW_HANDOVER_TIMING_METRICS
ENV EXPO_PUBLIC_HIDE_LEGACY_FIELDS=$EXPO_PUBLIC_HIDE_LEGACY_FIELDS
ENV EXPO_PUBLIC_ENABLE_ICEA_BRIDGE=$EXPO_PUBLIC_ENABLE_ICEA_BRIDGE
ENV EXPO_PUBLIC_ENABLE_ICEA_IMMEDIATE_SCORING=$EXPO_PUBLIC_ENABLE_ICEA_IMMEDIATE_SCORING
ENV EXPO_PUBLIC_ENABLE_ICEA_ENRICHED_SCORING=$EXPO_PUBLIC_ENABLE_ICEA_ENRICHED_SCORING
ENV EXPO_PUBLIC_ENABLE_ICEA_PATIENT_RISK=$EXPO_PUBLIC_ENABLE_ICEA_PATIENT_RISK
ENV EXPO_PUBLIC_ENABLE_ICEA_CAUSAL_SUMMARY=$EXPO_PUBLIC_ENABLE_ICEA_CAUSAL_SUMMARY
ENV EXPO_PUBLIC_AI_SUGGESTIONS_ENABLED=$EXPO_PUBLIC_AI_SUGGESTIONS_ENABLED
ENV EXPO_PUBLIC_ENABLE_DEMO=$EXPO_PUBLIC_ENABLE_DEMO
ENV OIDC_ISSUER=$OIDC_ISSUER
ENV OIDC_CLIENT_ID=$OIDC_CLIENT_ID
ENV OIDC_AUDIENCE=$OIDC_AUDIENCE
ENV OIDC_SCOPE=$OIDC_SCOPE
ENV OIDC_REDIRECT_SCHEME=$OIDC_REDIRECT_SCHEME

RUN pnpm expo export --platform web

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
