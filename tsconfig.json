{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/src/*": ["src/*"],
      "expo-file-system": ["src/types/expo-file-system-stub"],
      "expo-file-system/*": ["src/types/expo-file-system-stub"]
    },
    "jsx": "react-jsx",
    "lib": ["es2021", "dom"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "tests/**",
    "src/lib/__tests__/**",
    "src/lib/**/*.spec.ts",
    "src/lib/**/*.test.ts"
  ]
}

