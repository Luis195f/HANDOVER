# Authentication (OIDC)
OIDC_ISSUER=https://YOUR_DOMAIN/
OIDC_CLIENT_ID=YOUR_CLIENT_ID
OIDC_AUDIENCE=YOUR_API_AUDIENCE
OIDC_SCOPE=openid profile email offline_access
OIDC_REDIRECT_SCHEME=handover-pro

# Django / backend security
DJANGO_DEBUG=false
HANDOVER_DEPLOYMENT_MODE=production
EXPO_PUBLIC_HANDOVER_DEPLOYMENT_MODE=production
ENABLE_SSL_REDIRECT=true
HANDOVER_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
HANDOVER_PRIVATE_KEY_PATH=/secure/path/handover-private.pem
HANDOVER_PUBLIC_KEY_PATH=/secure/path/handover-public.pem
HANDOVER_BUNDLE_RETENTION_DAYS=30
HANDOVER_TECHNICAL_RETENTION_DAYS=30
# Backend-only secret for Django. Keep it out of EXPO_PUBLIC_* and mobile/web client env.
HANDOVER_BUNDLE_ENCRYPTION_KEY=
# Solo dev/demo/test controlado: HANDOVER_SIGNATURE_DISABLED=true

# FHIR API configuration
FHIR_BASE_URL=https://fhir.example.com
# EXPO_PUBLIC_HANDOVER_FHIR_VALIDATION_MODE=off

# Pilot control plane (read-only config/runtime)
# Keep backend and frontend JSON aligned for a governed rollout.
# EXPO_PUBLIC_HANDOVER_PILOT_CONTROL_JSON={"pilotMode":"pilot","rolloutStatus":"pause","enabledUnits":["icu-a"],"allowedRoles":["nurse","supervisor","admin"],"environmentScope":["pilot"],"explicitShadowModeForIcea":true,"features":{"icea_bridge":{"mode":"shadow","enabledUnits":["icu-a"]},"icea_patient_risk":{"mode":"disabled"},"governed_nnn":{"mode":"pilot","enabledUnits":["icu-a"]},"admin_analytics":{"mode":"shadow","allowedRoles":["supervisor","admin"]}}}
# HANDOVER_PILOT_CONTROL_JSON={"pilotMode":"pilot","rolloutStatus":"pause","enabledUnits":["icu-a"],"allowedRoles":["nurse","supervisor","admin"],"environmentScope":["pilot"],"explicitShadowModeForIcea":true,"features":{"icea_bridge":{"mode":"shadow","enabledUnits":["icu-a"]},"icea_patient_risk":{"mode":"disabled"},"governed_nnn":{"mode":"pilot","enabledUnits":["icu-a"]},"admin_analytics":{"mode":"shadow","allowedRoles":["supervisor","admin"]}}}

# NANDA catalog runtime configuration
# EXPO_PUBLIC_NANDA_CATALOG_URL=https://terminology.example.com/nanda-catalog.json
# EXPO_PUBLIC_NANDA_CATALOG_JSON={"licensed":true,"version":"2026","codes":[{"system":"NANDA","code":"00001","display":"Oxigenación alterada"}]}

# Offline queue encryption
# The app generates and stores the offline key in secure storage at first run.
# EXPO_PUBLIC_OFFLINE_ENCRYPTION_DISABLED=false

# Client-side Bundle signing (ECDSA P-256 + SHA-256)
# Dev/demo only. Pilot/production should rely on backend-managed signature enforcement.
# EXPO_PUBLIC_CLIENT_SIGNING_ENABLED=false

# ICEA+ webhook
ICEA_WEBHOOK_ENABLED=false
ICEA_WEBHOOK_URL=https://icea.example/api/v1/pipeline/ingest/
ICEA_WEBHOOK_SECRET=
ICEA_WEBHOOK_TIMEOUT_MS=2500
ICEA_WEBHOOK_RETRY_MAX=5
ICEA_WEBHOOK_ANTI_REPLAY=false
ICEA_WEBHOOK_REPLAY_WINDOW_SECONDS=300

# ICEA+ analytic bridge (frontend visibility)
# Backend real scoring still requires ENABLE_ICEA_BRIDGE + ICEA_BRIDGE_MODEL_ID on Django.
# Operational observability stays backend-mediated; the mobile app does not call ICEA+ directly for ops.
# Enriched scoring stays opt-in and defaults to false across frontend/backend/docs.
EXPO_PUBLIC_ENABLE_ICEA_BRIDGE=false
EXPO_PUBLIC_ENABLE_ICEA_IMMEDIATE_SCORING=false
EXPO_PUBLIC_ENABLE_ICEA_ENRICHED_SCORING=false
EXPO_PUBLIC_ENABLE_ICEA_PATIENT_RISK=false
EXPO_PUBLIC_ENABLE_ICEA_CAUSAL_SUMMARY=false
EXPO_PUBLIC_AI_SUGGESTIONS_ENABLED=false


