# Deployment mode: development | demo | test | pilot | production
HANDOVER_DEPLOYMENT_MODE=production
HANDOVER_FHIR_VALIDATION_MODE=local
# Read-only pilot rollout control plane. Keep aligned with frontend runtime config when the app needs to hide/show surfaces.
# HANDOVER_PILOT_CONTROL_JSON={"pilotMode":"pilot","rolloutStatus":"pause","enabledUnits":["icu-a"],"allowedRoles":["nurse","supervisor","admin"],"environmentScope":["pilot"],"explicitShadowModeForIcea":true,"features":{"icea_bridge":{"mode":"shadow","enabledUnits":["icu-a"]},"icea_patient_risk":{"mode":"disabled"},"governed_nnn":{"mode":"pilot","enabledUnits":["icu-a"]},"admin_analytics":{"mode":"shadow","allowedRoles":["supervisor","admin"]}}}
HANDOVER_PRIVATE_KEY_PATH=/secure/path/handover-private.pem
HANDOVER_PUBLIC_KEY_PATH=/secure/path/handover-public.pem
# Solo dev/demo/test controlado: HANDOVER_SIGNATURE_DISABLED=true

# Auth0 JWT settings for Django/DRF
# Required outside real tests and outside explicit local debug
# (HANDOVER_DEPLOYMENT_MODE=development|demo with DJANGO_DEBUG=true).
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=

# Audio upload security
HANDOVER_MAX_AUDIO_BYTES=26214400
AI_SUGGESTIONS_ENABLED=false
HANDOVER_BUNDLE_RETENTION_DAYS=30
HANDOVER_TECHNICAL_RETENTION_DAYS=30
# Backend-only: set a dedicated high-entropy secret for audit payload hashes and patient pseudonyms.
# If omitted, HANDOVER falls back to SECRET_KEY for compatibility.
AUDIT_HASH_SECRET=
# Backend-only: set a dedicated high-entropy secret in production so persisted bundles
# do not rely on SECRET_KEY-derived encryption material.
HANDOVER_BUNDLE_ENCRYPTION_KEY=

# Licensed NNN catalogs (optional, BYO-license)
# NANDA_CATALOG_FILE=/secure/path/to/nanda-catalog.json
# NANDA_CATALOG_JSON={"licensed":true,"version":"2026","codes":[{"system":"NANDA","code":"00001","display":"Oxigenación alterada"}]}
# NIC_CATALOG_FILE=/secure/path/to/nic-catalog.json
# NIC_CATALOG_JSON={"licensed":true,"version":"2026","codes":[{"system":"NIC","code":"2210","display":"Administración de analgésicos"}]}
# NOC_CATALOG_FILE=/secure/path/to/noc-catalog.json
# NOC_CATALOG_JSON={"licensed":true,"version":"2026","codes":[{"system":"NOC","code":"0402","display":"Estado respiratorio: permeabilidad de las vías aéreas"}]}

# ICEA+ webhook
ICEA_WEBHOOK_ENABLED=false
ICEA_WEBHOOK_URL=https://icea.example/api/v1/pipeline/ingest/
ICEA_WEBHOOK_SECRET=
ICEA_WEBHOOK_TIMEOUT_MS=2500
ICEA_WEBHOOK_RETRY_MAX=5
ICEA_WEBHOOK_ANTI_REPLAY=false
ICEA_WEBHOOK_REPLAY_WINDOW_SECONDS=300

# ICEA+ analytic bridge
ENABLE_ICEA_BRIDGE=false
ENABLE_ICEA_IMMEDIATE_SCORING=false
ENABLE_ICEA_ENRICHED_SCORING=false
ENABLE_ICEA_PATIENT_RISK=false
ENABLE_ICEA_CAUSAL_SUMMARY=false
ENABLE_ICEA_OPS_SUMMARY=false
ENABLE_ICEA_OPS_EVENTS=false
# Required for real ICEA+ score delivery. Leave empty only if the bridge stays disabled.
ICEA_BRIDGE_MODEL_ID=
ICEA_BRIDGE_TIMEOUT_MS=5000
ICEA_BRIDGE_RETRY_MAX=3
ICEA_BRIDGE_RETRY_BASE_SECONDS=30
ICEA_BRIDGE_RETRY_MAX_DELAY_SECONDS=300
# Optional comma-separated override. Defaults to 408,409,425,429,500,502,503,504.
# ICEA_BRIDGE_RETRYABLE_STATUS_CODES=408,409,425,429,500,502,503,504
ICEA_BRIDGE_SCORE_PATH=/api/v1/icea-plus/score/
# Optional: leave empty unless the upstream exposes a real score status endpoint.
ICEA_BRIDGE_STATUS_PATH=
ICEA_BRIDGE_STALE_AFTER_SECONDS=1800


